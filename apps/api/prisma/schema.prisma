// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    user
    admin
}

model User {
    id                     String                  @id @default(uuid(7)) @db.Uuid
    email                  String                  @unique
    passwordHash           String                  @map("password_hash")
    nickname               String                  @unique
    role                   UserRole                @default(user)
    avatarConfig           Json?
    bio                    String?                 @db.VarChar(200)
    profilePublic          Boolean                 @default(false) @map("profile_public")
    tags                   String[]                @default([])
    isTestAccount          Boolean                 @default(false) @map("is_test_account")
    createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
    tickets                Ticket[]
    userMovies             UserMovie[]
    reviewPosts            ReviewPost[]
    reviewPostLikes        ReviewPostLike[]
    lobbyVisits            LobbyVisit[]
    cafeMessages           CafeMessage[]
    cafeTableSeats         CafeTableSeat[]
    loginLogs              AdminLoginLog[]
    movieProviderOverrides MovieProviderOverride[]
    quotePosts             QuotePost[]
    quotePostBookmarks     QuotePostBookmark[]

    @@map("users")
}

enum UserMovieKind {
    wish
    watched
}

model UserMovie {
    id           String        @id @default(uuid(7)) @db.Uuid
    userId       String        @map("user_id") @db.Uuid
    tmdbId       Int           @map("tmdb_id")
    kind         UserMovieKind
    isDisplayed  Boolean       @default(false) @map("is_displayed")
    displayOrder Int?          @map("display_order")
    wallSlot     Int?          @map("wall_slot")
    createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, tmdbId, kind])
    @@map("user_movies")
}

enum TicketStatus {
    issued
    used
}

model Ticket {
    id         String       @id @default(uuid(7)) @db.Uuid
    userId     String       @map("user_id") @db.Uuid
    ticketDate DateTime     @map("ticket_date") @db.Date
    machineId  String?      @map("machine_id") @db.VarChar(32)
    tmdbId     Int?         @map("tmdb_id")
    status     TicketStatus
    issuedAt   DateTime?    @map("issued_at") @db.Timestamptz(3)
    usedAt     DateTime?    @map("used_at") @db.Timestamptz(3)
    createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, ticketDate])
    @@map("tickets")
}

model MoviePool {
    id              String   @id @default(uuid(7)) @db.Uuid
    tmdbId          Int      @unique @map("tmdb_id")
    title           String
    overview        String   @db.Text
    posterPath      String?  @map("poster_path")
    releaseDate     String   @default("") @map("release_date")
    director        String?
    genreIds        Int[]    @default([]) @map("genre_ids")
    originCountries String[] @default([]) @map("origin_countries")
    providers       Json     @default("[]")
    syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

    @@map("movie_pool")
}

model ReviewPost {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    tmdbId    Int      @map("tmdb_id")
    body      String   @db.Text
    rating    Float
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    user            User             @relation(fields: [userId], references: [id])
    reviewPostLikes ReviewPostLike[]

    @@index([createdAt(sort: Desc)])
    @@map("review_posts")
}

model ReviewPostLike {
    id        String   @id @default(uuid(7)) @db.Uuid
    postId    String   @map("post_id") @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    post ReviewPost @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postId, userId])
    @@map("review_post_likes")
}

model LobbyVisit {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    visitDate DateTime @map("visit_date") @db.Date
    visitedAt DateTime @default(now()) @map("visited_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, visitDate])
    @@index([visitDate])
    @@index([visitedAt])
    @@map("lobby_visits")
}

model AnonVisit {
    id         String   @id @default(uuid(7)) @db.Uuid
    visitorKey String   @map("visitor_key") @db.VarChar(36)
    place      String   @db.VarChar(16)
    visitDate  DateTime @map("visit_date") @db.Date
    visitedAt  DateTime @default(now()) @map("visited_at") @db.Timestamptz(3)

    @@unique([visitorKey, place, visitDate])
    @@index([visitDate, place])
    @@map("anon_visits")
}

enum CafeTableAccess {
    open
    locked
}

model CafeTableSession {
    tableId   String          @id @map("table_id") @db.VarChar(1)
    label     String?
    access    CafeTableAccess @default(open)
    updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

    messages CafeMessage[]
    seats    CafeTableSeat[]

    @@map("cafe_table_sessions")
}

model CafeTableSeat {
    tableId  String           @map("table_id") @db.VarChar(1)
    userId   String           @map("user_id") @db.Uuid
    joinedAt DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
    session  CafeTableSession @relation(fields: [tableId], references: [tableId], onDelete: Cascade)
    user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([tableId, userId])
    @@index([tableId])
    @@map("cafe_table_seats")
}

model CafeMessage {
    id        String   @id @default(uuid(7)) @db.Uuid
    tableId   String   @map("table_id") @db.VarChar(1)
    userId    String   @map("user_id") @db.Uuid
    body      String   @db.Text
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    session CafeTableSession @relation(fields: [tableId], references: [tableId], onDelete: Cascade)
    user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([tableId, createdAt(sort: Desc)])
    @@map("cafe_messages")
}

model AdminLoginLog {
    id       String   @id @default(uuid(7)) @db.Uuid
    userId   String   @map("user_id") @db.Uuid
    loggedAt DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([loggedAt(sort: Desc)])
    @@index([userId, loggedAt(sort: Desc)])
    @@map("admin_login_logs")
}

model AdminDailyStat {
    date          DateTime @id @db.Date
    visits        Int      @default(0)
    logins        Int      @default(0)
    ticketsIssued Int      @default(0) @map("tickets_issued")
    ticketsUsed   Int      @default(0) @map("tickets_used")
    reviews       Int      @default(0)
    cafeMessages  Int      @default(0) @map("cafe_messages")
    updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("admin_daily_stats")
}

model AdminHourlyStat {
    date         DateTime @db.Date
    hour         Int
    visits       Int      @default(0)
    logins       Int      @default(0)
    cafeMessages Int      @default(0) @map("cafe_messages")
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@id([date, hour])
    @@map("admin_hourly_stats")
}

enum MovieProviderOverrideAction {
    add
    remove
}

model MovieProviderOverride {
    id           String                      @id @default(uuid(7)) @db.Uuid
    tmdbId       Int                         @map("tmdb_id")
    providerId   Int                         @map("provider_id")
    providerName String                      @map("provider_name")
    logoPath     String?                     @map("logo_path")
    action       MovieProviderOverrideAction
    note         String?
    createdBy    String                      @map("created_by") @db.Uuid
    createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

    createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

    @@unique([tmdbId, providerId, action])
    @@index([tmdbId])
    @@map("movie_provider_overrides")
}

model CafeNotice {
    id        String   @id @default(uuid(7)) @db.Uuid
    key       String   @unique @default("cafe") @db.VarChar(16)
    kicker    String   @default("CINEMO SNACK BAR") @db.VarChar(64)
    title     String   @default("주의사항") @db.VarChar(128)
    rules     String[] @default([])
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("cafe_notices")
}

model LobbyGuide {
    id        String   @id @default(uuid(7)) @db.Uuid
    key       String   @unique @default("guide") @db.VarChar(16)
    steps     Json     @default("[]")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("lobby_guides")
}

enum MoviePoolSeedRunStatus {
    running
    succeeded
    partial
    failed
    cancelled
}

enum MoviePoolSeedTrigger {
    cron
    manual
}

model MoviePoolSeedRun {
    id             String                 @id @default(uuid(7)) @db.Uuid
    trigger        MoviePoolSeedTrigger
    status         MoviePoolSeedRunStatus @default(running)
    pages          Int
    machineCount   Int                    @map("machine_count")
    processedPages Int                    @default(0) @map("processed_pages")
    fetchedCount   Int                    @default(0) @map("fetched_count")
    savedCount     Int                    @default(0) @map("saved_count")
    skippedCount   Int                    @default(0) @map("skipped_count")
    failedCount    Int                    @default(0) @map("failed_count")
    errorMessage   String?                @map("error_message") @db.Text
    startedAt      DateTime               @default(now()) @map("started_at") @db.Timestamptz(3)
    finishedAt     DateTime?              @map("finished_at") @db.Timestamptz(3)

    @@index([startedAt])
    @@map("movie_pool_seed_runs")
}

enum AdminDailyReportStatus {
    running
    succeeded
    failed
}

model AdminDailyReport {
    id             String                 @id @default(uuid(7)) @db.Uuid
    reportDate     DateTime               @unique @map("report_date") @db.Date
    status         AdminDailyReportStatus @default(running)
    filename       String?
    dailyRowCount  Int                    @default(0) @map("daily_row_count")
    hourlyRowCount Int                    @default(0) @map("hourly_row_count")
    visitRowCount  Int                    @default(0) @map("visit_row_count")
    loginRowCount  Int                    @default(0) @map("login_row_count")
    errorMessage   String?                @map("error_message") @db.Text
    startedAt      DateTime               @default(now()) @map("started_at")
    finishedAt     DateTime?              @map("finished_at")
    createdAt      DateTime               @default(now()) @map("created_at")
    updatedAt      DateTime               @updatedAt @map("updated_at")

    @@index([startedAt(sort: Desc)])
    @@map("admin_daily_reports")
}

model QuotePost {
    id                  String   @id @default(uuid(7)) @db.Uuid
    userId              String   @map("user_id") @db.Uuid
    tmdbId              Int      @map("tmdb_id")
    movieTitle          String?  @map("movie_title")
    text                String   @db.VarChar(1000)
    usePosterBackground Boolean  @default(true) @map("use_poster_background")
    createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updaatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    quotePostBookmarks QuotePostBookmark[]

    @@unique([userId, tmdbId, text])
    @@index([tmdbId])
    @@index([createdAt(sort: Desc)])
    @@map("quote_posts")
}

model QuotePostBookmark {
    id          String   @id @default(uuid(7)) @db.Uuid
    userId      String   @map("user_id") @db.Uuid
    quotePostId String   @map("quote_post_id") @db.Uuid
    createdAt   DateTime @default(now()) @map("create_at") @db.Timestamptz(3)

    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    quotePost QuotePost @relation(fields: [quotePostId], references: [id], onDelete: Cascade)

    @@unique([userId, quotePostId])
    @@index([userId, createdAt(sort: Desc)])
    @@index([quotePostId])
    @@map("quote_post_bookmarks")
}
