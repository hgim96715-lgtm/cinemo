// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증·사용자
// ─────────────────────────────────────────────

enum UserRole {
    user
    admin
}

enum LoginProvider {
    email
    google
    naver
    kakao
    apple
}

enum AuthProvider {
    google
    naver
    apple
    kakao
}

model User {
    id                        String                     @id @default(uuid(7)) @db.Uuid
    email                     String                     @unique
    passwordHash              String                     @map("password_hash")
    nickname                  String                     @unique
    role                      UserRole                   @default(user)
    lastLoginProvider         LoginProvider?
    avatarConfig              Json?
    bio                       String?                    @db.VarChar(200)
    profilePublic             Boolean                    @default(false) @map("profile_public")
    tags                      String[]                   @default([])
    isTestAccount             Boolean                    @default(false) @map("is_test_account")
    createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
    socialAccounts            SocialAccount[]
    oauthLoginCodes           OAuthLoginCode[]
    passwordResetTokens       PasswordResetToken[]
    tickets                   Ticket[]
    userMovies                UserMovie[]
    movieReleaseNotifications MovieReleaseNotification[]
    lobbyVisits               LobbyVisit[]
    loginLogs                 AdminLoginLog[]
    movieProviderOverrides    MovieProviderOverride[]
    postcards                 Postcard[]
    postcardBookmarks         PostcardBookmark[]
    postcardReactions         PostcardReaction[]
    postcardComments          PostcardComment[]
    postcardCommentReactions  PostcardCommentReaction[]

    @@map("users")
}

model SocialAccount {
    id                String       @id @default(uuid(7)) @db.Uuid
    userId            String       @map("user_id") @db.Uuid
    provider          AuthProvider
    providerAccountId String       @map("provider_account_id")
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
    @@map("social_accounts")
}

model OAuthLoginCode {
    id         String    @id @default(uuid(7)) @db.Uuid
    userId     String    @map("user_id") @db.Uuid
    codeHash   String    @unique @map("code_hash")
    expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
    consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
    createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([expiresAt])
    @@index([userId])
    @@map("oauth_login_codes")
}

model PasswordResetToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    tokenHash String    @unique @map("token_hash")
    expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
    usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// 영화·사용자 영화 활동
// ─────────────────────────────────────────────

enum UserMovieKind {
    wish
    watched
}

enum UserMovieViewingType {
    theater
    home
    other
}

enum TicketStatus {
    issued
    used
}

model MoviePool {
    id              String   @id @default(uuid(7)) @db.Uuid
    tmdbId          Int      @unique @map("tmdb_id")
    title           String
    overview        String   @db.Text
    posterPath      String?  @map("poster_path")
    releaseDate     String   @default("") @map("release_date")
    director        String?
    genreIds        Int[]    @default([]) @map("genre_ids")
    originCountries String[] @default([]) @map("origin_countries")
    providers       Json     @default("[]")
    syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

    @@map("movie_pool")
}

model UserMovie {
    id                String                @id @default(uuid(7)) @db.Uuid
    userId            String                @map("user_id") @db.Uuid
    tmdbId            Int                   @map("tmdb_id")
    kind              UserMovieKind
    watchedAt         DateTime?             @map("watched_at") @db.Timestamptz(3)
    viewingType       UserMovieViewingType? @map("viewing_type")
    viewingTypeCustom String?               @map("viewing_type_custom") @db.VarChar(100)
    viewingPlatform   String?               @map("viewing_platform") @db.VarChar(40)
    viewingLocation   String?               @map("viewing_location") @db.VarChar(100)
    review            String?               @db.Text
    rating            Int?                  @db.SmallInt
    isDisplayed       Boolean               @default(false) @map("is_displayed")
    displayOrder      Int?                  @map("display_order")
    wallSlot          Int?                  @map("wall_slot")
    createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, tmdbId, kind])
    @@map("user_movies")
}

model Ticket {
    id         String       @id @default(uuid(7)) @db.Uuid
    userId     String       @map("user_id") @db.Uuid
    ticketDate DateTime     @map("ticket_date") @db.Date
    machineId  String?      @map("machine_id") @db.VarChar(32)
    tmdbId     Int?         @map("tmdb_id")
    status     TicketStatus
    issuedAt   DateTime?    @map("issued_at") @db.Timestamptz(3)
    usedAt     DateTime?    @map("used_at") @db.Timestamptz(3)
    createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, ticketDate])
    @@map("tickets")
}

model MovieReleaseNotification {
    id          String    @id @default(uuid(7)) @db.Uuid
    userId      String    @map("user_id") @db.Uuid
    tmdbId      Int       @map("tmdb_id")
    releaseDate DateTime  @map("release_date") @db.Date
    enabled     Boolean   @default(true)
    sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, tmdbId])
    @@index([enabled, releaseDate, sentAt])
    @@map("movie_release_notifications")
}

// ─────────────────────────────────────────────
// 영화·사용자 콘텐츠
// ─────────────────────────────────────────────

model Postcard {
    id           String   @id @default(uuid(7)) @db.Uuid
    userId       String   @map("user_id") @db.Uuid
    tmdbId       Int      @map("tmdb_id")
    movieTitle   String?  @map("movie_title")
    originalText String?  @map("original_text") @db.Text
    text         String   @db.Text
    posterPath   String?  @map("poster_path")
    isPublic     Boolean  @default(true) @map("is_public")
    isPinned     Boolean  @default(false) @map("is_pinned")
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    postcardBookmarks PostcardBookmark[]
    postcardReactions PostcardReaction[]
    postcardComments  PostcardComment[]

    @@index([userId, createdAt(sort: Desc)])
    @@index([tmdbId])
    @@index([isPublic, createdAt(sort: Desc)])
    @@map("postercards")
}

model PostcardBookmark {
    id         String   @id @default(uuid(7)) @db.Uuid
    postcardId String   @map("postcard_id") @db.Uuid
    userId     String   @map("user_id") @db.Uuid
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postcardId, userId])
    @@index([userId, createdAt(sort: Desc)])
    @@index([postcardId])
    @@map("postcard_bookmarks")
}

model PostcardReaction {
    id         String   @id @default(uuid(7)) @db.Uuid
    postcardId String   @map("postcard_id") @db.Uuid
    userId     String   @map("user_id") @db.Uuid
    emoji      String   @db.VarChar(32)
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postcardId, userId, emoji])
    @@index([postcardId, emoji])
    @@index([emoji, postcardId])
    @@index([userId, createdAt(sort: Desc)])
    @@map("postcard_reactions")
}

model PostcardComment {
    id         String   @id @default(uuid(7)) @db.Uuid
    postcardId String   @map("postcard_id") @db.Uuid
    userId     String   @map("user_id") @db.Uuid
    parentId   String?  @map("parent_id") @db.Uuid
    text       String   @db.Text
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    parent    PostcardComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies   PostcardComment[]         @relation("CommentReplies")
    reactions PostcardCommentReaction[]

    @@index([postcardId, createdAt(sort: Desc)])
    @@index([parentId, createdAt(sort: Desc)])
    @@index([userId, createdAt(sort: Desc)])
    @@map("postcard_comments")
}

model PostcardCommentReaction {
    id        String   @id @default(uuid(7)) @db.Uuid
    commentId String   @map("comment_id") @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    emoji     String   @db.VarChar(32)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    comment PostcardComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([commentId, userId, emoji])
    @@index([commentId, emoji])
    @@index([userId, createdAt(sort: Desc)])
    @@map("postcard_comment_reactions")
}

// ─────────────────────────────────────────────
// 로비
// ─────────────────────────────────────────────

model LobbyVisit {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    visitDate DateTime @map("visit_date") @db.Date
    visitedAt DateTime @default(now()) @map("visited_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, visitDate])
    @@index([visitDate])
    @@index([visitedAt])
    @@map("lobby_visits")
}

// ─────────────────────────────────────────────
// 관리자·운영
// ─────────────────────────────────────────────

model AdminLoginLog {
    id       String   @id @default(uuid(7)) @db.Uuid
    userId   String   @map("user_id") @db.Uuid
    loggedAt DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([loggedAt(sort: Desc)])
    @@index([userId, loggedAt(sort: Desc)])
    @@map("admin_login_logs")
}

model AdminDailyStat {
    date          DateTime @id @db.Date
    visits        Int      @default(0)
    logins        Int      @default(0)
    ticketsIssued Int      @default(0) @map("tickets_issued")
    ticketsUsed   Int      @default(0) @map("tickets_used")
    updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("admin_daily_stats")
}

model AdminHourlyStat {
    date      DateTime @db.Date
    hour      Int
    visits    Int      @default(0)
    logins    Int      @default(0)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@id([date, hour])
    @@map("admin_hourly_stats")
}

enum MovieProviderOverrideAction {
    add
    remove
}

model MovieProviderOverride {
    id           String                      @id @default(uuid(7)) @db.Uuid
    tmdbId       Int                         @map("tmdb_id")
    providerId   Int                         @map("provider_id")
    providerName String                      @map("provider_name")
    logoPath     String?                     @map("logo_path")
    action       MovieProviderOverrideAction
    note         String?
    createdBy    String                      @map("created_by") @db.Uuid
    createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

    createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

    @@unique([tmdbId, providerId, action])
    @@index([tmdbId])
    @@map("movie_provider_overrides")
}

model LobbyGuide {
    id        String   @id @default(uuid(7)) @db.Uuid
    key       String   @unique @default("guide") @db.VarChar(16)
    steps     Json     @default("[]")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("lobby_guides")
}

enum MoviePoolSeedRunStatus {
    running
    succeeded
    partial
    failed
    cancelled
}

enum MoviePoolSeedTrigger {
    cron
    manual
}

model MoviePoolSeedRun {
    id             String                 @id @default(uuid(7)) @db.Uuid
    trigger        MoviePoolSeedTrigger
    status         MoviePoolSeedRunStatus @default(running)
    pages          Int
    machineCount   Int                    @map("machine_count")
    processedPages Int                    @default(0) @map("processed_pages")
    fetchedCount   Int                    @default(0) @map("fetched_count")
    savedCount     Int                    @default(0) @map("saved_count")
    skippedCount   Int                    @default(0) @map("skipped_count")
    failedCount    Int                    @default(0) @map("failed_count")
    errorMessage   String?                @map("error_message") @db.Text
    startedAt      DateTime               @default(now()) @map("started_at") @db.Timestamptz(3)
    finishedAt     DateTime?              @map("finished_at") @db.Timestamptz(3)

    @@index([startedAt])
    @@map("movie_pool_seed_runs")
}

enum AdminDailyReportStatus {
    running
    succeeded
    failed
}

model AdminDailyReport {
    id             String                 @id @default(uuid(7)) @db.Uuid
    reportDate     DateTime               @unique @map("report_date") @db.Date
    status         AdminDailyReportStatus @default(running)
    filename       String?
    dailyRowCount  Int                    @default(0) @map("daily_row_count")
    hourlyRowCount Int                    @default(0) @map("hourly_row_count")
    visitRowCount  Int                    @default(0) @map("visit_row_count")
    loginRowCount  Int                    @default(0) @map("login_row_count")
    errorMessage   String?                @map("error_message") @db.Text
    startedAt      DateTime               @default(now()) @map("started_at")
    finishedAt     DateTime?              @map("finished_at")
    createdAt      DateTime               @default(now()) @map("created_at")
    updatedAt      DateTime               @updatedAt @map("updated_at")

    @@index([startedAt(sort: Desc)])
    @@map("admin_daily_reports")
}
